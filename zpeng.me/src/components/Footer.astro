---
import logo from '../assets/brand/logo-white.svg';
import { works, publications, elsewhere } from '../lib/nav';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main">
    <section class="footer-brand">
      <a href="/"><img src={logo.src} width={logo.width} height={logo.height} alt="Z. Peng" loading="lazy" /></a>
      <p class="footer-tagline">Radar systems engineer working on automotive radar, signal processing, and antenna arrays. I also build open-source tools and small robots.</p>
      <ul class="footer-contact">
        <li><i class="fa-solid fa-location-dot"></i> Westfield, Indiana, USA</li>
        <li><i class="fa-solid fa-envelope"></i> zpeng.me<i class="fa-solid fa-at at"></i>gmail.com</li>
      </ul>
    </section>
    <nav class="footer-col" aria-label="Projects">
      <h2>Projects</h2>
      <ul>
        {works.map((w) => <li><a href={w.href}>{w.label}</a></li>)}
      </ul>
    </nav>
    <nav class="footer-col" aria-label="Publications">
      <h2>Publications</h2>
      <ul>
        {publications.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>
    </nav>
    <nav class="footer-col" aria-label="Elsewhere">
      <h2>Elsewhere</h2>
      <ul>
        {elsewhere.map((e) => (
          <li>
            <a href={e.href} {...(e.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              <i class={e.icon}></i>{e.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="footer-bar">
    <span>&copy; 2018&ndash;{year} Zhengyu Peng &middot; zpeng.me</span>
    <span class="footer-bar-links">
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="#" aria-label="Back to top">Back to top <i class="fa-solid fa-arrow-up"></i></a>
    </span>
  </div>
</footer>
