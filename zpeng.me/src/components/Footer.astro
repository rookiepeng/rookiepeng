---
import logo from '../assets/brand/logo-white.svg';
import { getTags } from '../lib/posts';

const tags = await getTags();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="cols">
    <section>
      <h2>Tags</h2>
      <nav class="tagcloud" aria-label="Tags">
        {[...tags].map(([slug, t]) => <a href={`/tag/${slug}/`}>{t.name}<sup>{t.posts.length}</sup></a>)}
      </nav>
    </section>
    <section class="footer-brand">
      <a href="/"><img src={logo.src} width={logo.width} height={logo.height} alt="Z. Peng" loading="lazy" /></a>
      <p><i class="fa-solid fa-location-dot"></i> Westfield, Indiana, USA</p>
      <p><i class="fa-solid fa-envelope"></i> zpeng.me<i class="fa-solid fa-at" style="width:auto"></i>gmail.com</p>
      <p><i class="fa-solid fa-copyright"></i> 2018 - {year} zpeng.me</p>
    </section>
    <section class="footer-links">
      <h2>Elsewhere</h2>
      <ul>
        <li><a href="https://github.com/rookiepeng" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> GitHub</a></li>
        <li><a href="https://scholar.google.com/citations?user=0vQPboMAAAAJ" target="_blank" rel="noopener"><i class="fa-brands fa-google-scholar"></i> Google Scholar</a></li>
        <li><a href="https://www.linkedin.com/in/zhengyup" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin-in"></i> LinkedIn</a></li>
        <li><a href="/feed.xml"><i class="fa-solid fa-rss"></i> RSS feed</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
      </ul>
    </section>
  </div>
</footer>
