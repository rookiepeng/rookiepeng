---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import banner from '../../../assets/brand/banner.svg';
import { formatDate, getTags, postUrl } from '../../../lib/posts';

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

const { name, posts } = Astro.props;
---
<Base title={`${name} – Z. PENG`} description={`Posts tagged ${name}.`}>
  <header class="page-head">
    <div class="inner">
      <div class="kicker">Tag</div>
      <h1>{name}</h1>
      <div class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</div>
    </div>
  </header>
  <div class="post-list">
    {posts.map((p) => (
      <a class="post-card" href={postUrl(p)}>
        <Image src={p.data.cover ?? banner} alt="" width={360} />
        <div>
          <h3>{p.data.title}</h3>
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
          {p.data.description && <p>{p.data.description}</p>}
        </div>
      </a>
    ))}
  </div>
</Base>
