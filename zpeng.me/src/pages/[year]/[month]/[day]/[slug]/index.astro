---
import { render } from 'astro:content';
import Post from '../../../../../layouts/Post.astro';
import { getPosts, postUrl } from '../../../../../lib/posts';
import { resolveHtmlImages } from '../../../../../lib/images';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const [, year, month, day, slug] = postUrl(post).split('/');
    return { params: { year, month, day, slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
// Hand-built HTML posts reference their images with <img src="./...">, which Markdown rendering leaves alone
const rawHtml = post.data.rawHtml ? await resolveHtmlImages(post.rendered?.html ?? '', post.id) : undefined;
---
<Post post={post}>
  {rawHtml ? <Fragment set:html={rawHtml} /> : <Content />}
</Post>
