---
import portable24Ghz3dMimoRadar3dView from '../../content/posts/portable-24-ghz-3d-mimo-radar/3d-view.jpg';
import kBand2dRfBeamformingFmcwRadarPhoto from '../../content/posts/k-band-2d-rf-beamforming-fmcw-radar/photo.jpg';
import kBandPortableMultiModeRadarPhoto from '../../content/posts/k-band-portable-multi-mode-radar/photo.jpg';
import cBandPortableMultiModeRadarPhoto from '../../content/posts/c-band-portable-multi-mode-radar/photo.jpg';
import _24GhzRadarOnChipPhoto from '../../content/posts/24-ghz-radar-on-chip/photo.jpg';
import adaptiveBeamformingArraySystem from '../../content/posts/adaptive-beamforming-array/system.jpg';
import kuBandHornArray from '../../content/posts/ku-band-high-gain-horn-antenna-array/array.jpg';
import widebandRfSignalSynthesizerPhoto from '../../content/posts/wideband-rf-signal-synthesizer/photo.jpg';
import { optimized } from '../../lib/images';
import { publicationCounts } from '../../lib/publications';
import Base from '../../layouts/Base.astro';
const count = await publicationCounts();
const portable24Ghz3dMimoRadar3dViewUrl = await optimized(portable24Ghz3dMimoRadar3dView, 800);
const kBand2dRfBeamformingFmcwRadarPhotoUrl = await optimized(kBand2dRfBeamformingFmcwRadarPhoto, 800);
const kBandPortableMultiModeRadarPhotoUrl = await optimized(kBandPortableMultiModeRadarPhoto, 800);
const cBandPortableMultiModeRadarPhotoUrl = await optimized(cBandPortableMultiModeRadarPhoto, 800);
const _24GhzRadarOnChipPhotoUrl = await optimized(_24GhzRadarOnChipPhoto, 800);
const adaptiveBeamformingArraySystemUrl = await optimized(adaptiveBeamformingArraySystem, 800);
const kuBandHornArrayUrl = await optimized(kuBandHornArray, 800);
const widebandRfSignalSynthesizerPhotoUrl = await optimized(widebandRfSignalSynthesizerPhoto, 800);
---
<Base title="Research Projects – Z. PENG" description="Radar, antenna array, and RF hardware projects from my studies at Zhejiang University and Texas Tech University." overlayHeader>
<style is:global>
/* MOBILE SUIT THEME (RX-78-2): white armour plates framed in navy, Federation blue,
   red and V-fin yellow trim. Light sections are the armour; the dark bands (hero,
   research impact) are the cockpit: a neutral gunmetal hero with Federation blue as the accent. Ported from hexapod-link. */
.zpeng-page *,.zpeng-page *::before,.zpeng-page *::after{box-sizing:border-box;margin:0;padding:0}
:root{
--bg:#f3f5f9;
--bg2:#dde3ec;
--bg3:#e8eef8;
--surface:#ffffff;
--border:#a9b6cc;
--border2:#7f8eab;
--frame:#1b2a4a;
--text:#0f1a30;
--text2:#2b3956;
--muted:#4a5875;
--accent:#1d4fa3;
--accent2:#163f84;
--accent-strong:#1d4fa3;
--accent-rgb:29,79,163;
--red:#d62828;
--yellow:#f2b705;
--gold:#8a6500;
--olive:#3f6e5e;
--hud:76,201,240;
--dark:#060c18;
--dark-text:#e4eeff;
--dark-text2:#c3d2ee;
--dark-muted:#8aa2c8;
--dark-accent:#5b8ff5;
--dark-yellow:#ffd23f;
--dark-red:#ff4d4d;
--shadow-hard:4px 4px 0 rgba(15,26,48,.18);
--shadow-hover:6px 6px 0 rgba(15,26,48,.24);
/* Mecha corners: top-right and bottom-left cut off at 45 degrees */
--chamfer-clip:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));
--chamfer-clip-sm:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));
}
.zpeng-page{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.6;overflow-x:hidden}

/* PAGE HERO: the gunmetal cockpit. Chest trim along the bottom edge: a red block, then yellow vent slats on blue */
#hero{min-height:42vh;position:relative;display:flex;align-items:center;background:linear-gradient(90deg,var(--dark-red) 0 160px,transparent 160px) bottom/100% 4px no-repeat,repeating-linear-gradient(90deg,var(--dark-yellow) 0 14px,transparent 14px 22px) bottom/100% 4px no-repeat,linear-gradient(var(--dark-accent),var(--dark-accent)) bottom/100% 4px no-repeat,radial-gradient(ellipse 55% 70% at 78% 42%,rgba(91,143,245,.08),transparent 70%),linear-gradient(135deg,#14171d 0%,#1b1f26 55%,#20242c 100%);--bg:#0e1014;--bg2:#15181e;--bg3:#1c2028;--border:#2a2f38;--border2:#4a515e;--text:#eef0f3;--text2:#c9ced6;--muted:#9299a5;--accent:var(--dark-accent);--hud:230,234,240;--accent-rgb:91,143,245;--red:var(--dark-red);--yellow:var(--dark-yellow);color:#eef0f3;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
/* Armour plating: chamfered plates in running bond, engraved panel lines, a maintenance hatch,
   vent slats, rivets and small caution decals. Fades out behind the text on the left */
#hero::before{content:'';position:absolute;inset:0 0 4px;pointer-events:none;z-index:0;background:url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='360' height='240'><g fill='%23fff'><path fill-opacity='.022' d='M2 2H344L358 16V118H16L2 104Z'/><path fill-opacity='.01' d='M0 122H164L178 136V238H0Z'/><path fill-opacity='.03' d='M182 122H360V238H196L182 224Z'/></g><g fill='none' stroke-linejoin='miter'><path stroke='%23fff' stroke-opacity='.04' transform='translate(1 1)' d='M2 2H344L358 16V118H16L2 104Z M0 122H164L178 136V238H0Z M182 122H360V238H196L182 224Z M2 70H118L148 40H250V2 M286 28H322L334 40V64H298L286 52Z M60 122V170L80 190H178 M182 182H258L280 204V238 M298 150H342M298 159H342M298 168H342M298 177H342M298 186H342'/><path stroke='%23000' stroke-opacity='.5' stroke-width='1.4' d='M2 2H344L358 16V118H16L2 104Z M0 122H164L178 136V238H0Z M182 122H360V238H196L182 224Z M2 70H118L148 40H250V2 M286 28H322L334 40V64H298L286 52Z M60 122V170L80 190H178 M182 182H258L280 204V238'/><path stroke='%23000' stroke-opacity='.4' stroke-width='2.5' d='M298 150H342M298 159H342M298 168H342M298 177H342M298 186H342'/></g><g fill='%23000' fill-opacity='.4'><circle cx='26' cy='104' r='2'/><circle cx='40' cy='104' r='2'/><circle cx='54' cy='104' r='2'/><circle cx='292' cy='34' r='1.6'/><circle cx='328' cy='58' r='1.6'/><circle cx='196' cy='132' r='2'/><circle cx='196' cy='170' r='2'/></g><rect x='14' y='132' width='26' height='5' fill='%23ffd23f' fill-opacity='.16'/><rect x='14' y='141' width='9' height='5' fill='%23ff4d4d' fill-opacity='.18'/><path d='M160 52l8 -8h22l-8 8z' fill='%235b8ff5' fill-opacity='.14'/></svg>") 0 0/480px 320px;-webkit-mask-image:linear-gradient(100deg,rgba(0,0,0,.4) 15%,#000 60%);mask-image:linear-gradient(100deg,rgba(0,0,0,.4) 15%,#000 60%)}
/* HUD targeting brackets in the four corners */
#hero::after{--hc:rgba(var(--hud),.4);--arm:22px;content:'';position:absolute;inset:16px 16px 20px;pointer-events:none;z-index:0;background:linear-gradient(var(--hc),var(--hc)) top left/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) top left/2px var(--arm),linear-gradient(var(--hc),var(--hc)) top right/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) top right/2px var(--arm),linear-gradient(var(--hc),var(--hc)) bottom left/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) bottom left/2px var(--arm),linear-gradient(var(--hc),var(--hc)) bottom right/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) bottom right/2px var(--arm);background-repeat:no-repeat}
#hero-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
.hero-inner{max-width:1200px;margin:0 auto;width:100%;padding:6rem 2rem 4rem;position:relative;z-index:1;animation:fadeUp .8s ease both}
.hero-tag{font-family:var(--mono);font-size:0.78rem;color:var(--accent);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:1.2rem;display:flex;align-items:center;gap:0.6rem}
.hero-tag::before{content:'';width:2rem;height:3px;background:linear-gradient(90deg,var(--red) 0 .5rem,var(--accent) .5rem)}
.zpeng-page h1{font-family:var(--serif);font-size:clamp(2.4rem,4.5vw,4rem);line-height:1.05;font-weight:400;letter-spacing:-0.01em;margin-bottom:1rem}
.zpeng-page h1 em{font-style:italic;color:var(--accent)}
.hero-bio{color:var(--text2);font-size:1.05rem;max-width:52ch;line-height:1.75}

/* SECTION COMMON */
.zpeng-page section{padding:6rem 2rem}
.zpeng-page section > *{max-width:1200px;margin-left:auto;margin-right:auto}
.section-header{display:flex;align-items:baseline;gap:1.5rem;margin-bottom:3rem}
.section-num{font-family:var(--mono);font-size:.8rem;font-weight:700;color:#fff;background:var(--accent-strong);padding:.15rem .55rem;letter-spacing:.1em;clip-path:var(--chamfer-clip-sm)}
.section-title{font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.6rem);font-weight:400;color:var(--text)}
/* Tricolour rule: blue, then a red and a yellow chip at the end */
.section-line{flex:1;height:4px;background:linear-gradient(90deg,var(--accent) 0 calc(100% - 56px),var(--red) calc(100% - 56px) calc(100% - 24px),var(--yellow) calc(100% - 24px))}

/* FILTER BAR */
.filter-bar{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:3rem}
.filter-btn{padding:.35rem .9rem;border:2px solid var(--border);border-radius:0;clip-path:var(--chamfer-clip-sm);font-size:.78rem;font-family:var(--mono);font-weight:700;letter-spacing:.06em;color:var(--text2);background:var(--surface);cursor:pointer;transition:border-color .1s,color .1s,background .1s,transform .1s}
.filter-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--surface);transform:translate(-1px,-1px)}
.filter-btn.active{border-color:var(--frame);color:#fff;background:var(--accent)}

/* PROJECT GRID */
#projects{background:var(--bg2)}
.proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}

.proj-card{background:var(--surface);border:2px solid var(--frame);border-radius:0;overflow:hidden;text-decoration:none;transition:transform .15s,border-color .15s,box-shadow .15s;display:flex;flex-direction:column;position:relative;box-shadow:var(--shadow-hard)}
.proj-card:hover{transform:translate(-2px,-2px);border-color:var(--accent);box-shadow:var(--shadow-hover)}

/* ARMOUR PLATE DETAILS: along the top edge a red chip, Federation blue and yellow
   vent slats at the right-hand end; in the bottom-right corner a navy reinforcing
   plate. */
.zpeng-page .proj-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;pointer-events:none;z-index:3;background:repeating-linear-gradient(90deg,var(--yellow) 0 5px,transparent 5px 9px) right 6px top/32px 100% no-repeat,linear-gradient(90deg,var(--red) 0 28px,var(--accent) 28px calc(100% - 44px),transparent calc(100% - 44px))}
.zpeng-page .proj-card::after{content:'';position:absolute;right:0;bottom:0;width:14px;height:14px;pointer-events:none;background:linear-gradient(135deg,transparent 50%,var(--frame) 50%)}

.proj-card-img-wrap{position:relative;overflow:hidden;height:190px;background:#0a1428}
/* HUD targeting brackets over the photo */
.proj-card-img-wrap::after{--hc:rgba(var(--hud),.75);--arm:14px;content:'';position:absolute;inset:10px;pointer-events:none;z-index:1;background:linear-gradient(var(--hc),var(--hc)) top left/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) top left/2px var(--arm),linear-gradient(var(--hc),var(--hc)) top right/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) top right/2px var(--arm),linear-gradient(var(--hc),var(--hc)) bottom left/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) bottom left/2px var(--arm),linear-gradient(var(--hc),var(--hc)) bottom right/var(--arm) 2px,linear-gradient(var(--hc),var(--hc)) bottom right/2px var(--arm);background-repeat:no-repeat}
.proj-card-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease,opacity .3s}
.proj-card:hover .proj-card-img{transform:scale(1.04);opacity:.9}
.proj-card-year{position:absolute;top:.9rem;right:.9rem;font-family:var(--mono);font-size:.68rem;font-weight:700;color:var(--frame);background:var(--yellow);border:1px solid var(--frame);border-radius:0;clip-path:var(--chamfer-clip-sm);padding:.18rem .5rem;letter-spacing:.04em;z-index:2}

.proj-card-body{padding:1.4rem;flex:1;display:flex;flex-direction:column}
.proj-card-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.75rem}
.proj-tag{font-family:var(--mono);font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.18rem .55rem;border-radius:0;clip-path:var(--chamfer-clip-sm);border:1px solid var(--border);color:var(--text2)}
.proj-tag.tag-radar{background:rgba(29,79,163,.08);color:var(--accent);border-color:rgba(29,79,163,.3)}
.proj-tag.tag-mimo{background:rgba(27,42,74,.07);color:var(--frame);border-color:rgba(27,42,74,.35)}
.proj-tag.tag-beamforming{background:rgba(214,40,40,.07);color:#b51f1f;border-color:rgba(214,40,40,.3)}
.proj-tag.tag-vital{background:rgba(242,183,5,.18);color:var(--gold);border-color:rgba(242,183,5,.6)}
.proj-tag.tag-ic{background:rgba(63,110,94,.08);color:var(--olive);border-color:rgba(63,110,94,.3)}
.proj-tag.tag-antenna{background:rgba(29,79,163,.05);color:var(--accent2);border-color:rgba(22,63,132,.4)}
.proj-tag.tag-rf{background:rgba(138,101,0,.08);color:var(--gold);border-color:rgba(138,101,0,.35)}
.proj-tag.tag-software{background:rgba(29,79,163,.08);color:var(--accent);border-color:rgba(29,79,163,.3)}

.proj-card h3{font-size:1.05rem;font-weight:700;color:var(--text);margin-bottom:.45rem;line-height:1.4;transition:color .2s}
.proj-card:hover h3{color:var(--accent)}
.proj-card p{font-size:.9rem;color:var(--text2);line-height:1.65;flex:1}
.proj-card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:1.1rem;padding-top:.9rem;border-top:2px solid var(--border)}
.proj-pub-count{font-family:var(--mono);font-size:.74rem;color:var(--muted);display:flex;align-items:center;gap:.35rem}
.proj-pub-count i{color:var(--accent);font-size:.75rem}
.proj-read-more{font-family:var(--mono);font-size:.74rem;color:var(--accent2);text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;border:1px solid rgba(29,79,163,.35);padding:.22rem .6rem;border-radius:0;clip-path:var(--chamfer-clip-sm);transition:border-color .1s,background .1s}
.proj-read-more:hover{border-color:var(--accent);background:rgba(29,79,163,.08);color:var(--accent2)}

/* SCHOOL GROUPS: one heading and grid per university */
.school-group + .school-group{margin-top:3.5rem}
.school-group.hidden{display:none}
.school-head{display:flex;align-items:baseline;flex-wrap:wrap;gap:.4rem 1.2rem;margin-bottom:1.5rem;padding-bottom:.7rem;border-bottom:2px solid var(--frame)}
.school-name{font-family:var(--serif);font-size:1.55rem;color:var(--text)}
.school-meta{font-family:var(--mono);font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}

/* HIGHLIGHT BANNER: cockpit band, chest trim along the top edge */
#highlight{position:relative;background:linear-gradient(90deg,var(--red) 0 160px,transparent 160px) top/100% 4px no-repeat,repeating-linear-gradient(90deg,var(--yellow) 0 14px,transparent 14px 22px) top/100% 4px no-repeat,linear-gradient(var(--accent),var(--accent)) top/100% 4px no-repeat,var(--dark);color:var(--dark-text);text-align:center;--accent:var(--dark-accent);--accent-strong:#2f68d6;--accent-rgb:91,143,245;--red:var(--dark-red);--yellow:var(--dark-yellow);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
#highlight::before{content:'';position:absolute;inset:4px 0 0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(var(--hud),.035) 0 1px,transparent 1px 3px)}
#highlight > *{position:relative;z-index:1;--border:#1e3563;--border2:#2f5fb3}
.hl-inner{max-width:1200px;margin:0 auto}
.hl-grid{display:flex;justify-content:center;gap:3rem;flex-wrap:wrap}
.hl-stat .n{font-family:var(--serif);font-size:2.8rem;color:var(--accent);line-height:1}
.hl-stat .l{font-size:.86rem;color:var(--dark-muted);margin-top:.3rem;letter-spacing:.02em}
.hl-cta{display:inline-flex;align-items:center;gap:.6rem;margin-top:2.5rem;color:var(--dark-text);font-size:.9rem;font-weight:600;text-decoration:none;border:2px solid var(--border2);border-radius:0;clip-path:var(--chamfer-clip);padding:.7rem 1.8rem;transition:border-color .1s,color .1s,background-color .1s,transform .1s}
.hl-cta:hover{border-color:var(--accent);color:var(--accent);background:rgba(var(--accent-rgb),.1);transform:translate(-1px,-1px)}

/* FOOTER */
.zpeng-page footer{border-top:1px solid var(--border)}
.footer-inner{max-width:1200px;margin:0 auto;padding:3rem 2rem;display:flex;justify-content:space-between;align-items:center}
.footer-left{font-family:var(--mono);font-size:.75rem;color:var(--muted)}
.footer-left a{color:var(--accent);text-decoration:none}
.footer-right{font-size:.75rem;color:var(--muted)}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:none}
.reveal-delay-1{transition-delay:.1s}
.reveal-delay-2{transition-delay:.2s}
.reveal-delay-3{transition-delay:.3s}
.reveal-delay-4{transition-delay:.4s}
.reveal-delay-5{transition-delay:.5s}

/* HIDDEN for filtering */
.proj-card.hidden{display:none}

@media(max-width:900px){
#hero{min-height:50vh}
.hero-inner{padding:5rem 1.5rem 3rem}
.zpeng-page section{padding:4rem 1.5rem}
.proj-grid{grid-template-columns:1fr}
.nav-inner{padding:.8rem 1.5rem}
.nav-links{gap:1.2rem}
.footer-inner{flex-direction:column;gap:.5rem;text-align:center}
.hl-grid{gap:2rem}
}
@media(prefers-reduced-motion:reduce){
.hero-inner{animation:none}
.reveal{transition:opacity .3s ease;transform:none}
}
@media(min-width:901px) and (max-width:1100px){
.proj-grid{grid-template-columns:repeat(2,1fr)}
}
</style>

<div class="zpeng-page">

<!-- HERO -->
<section id="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="hero-inner">
    <div class="hero-tag">Research &middot; ZJU &amp; TTU &middot; 2007&ndash;2018</div>
    <h1>Research<br><em>Projects</em></h1>
    <p class="hero-bio">Radar systems, antenna arrays, and RF hardware I built at Zhejiang University and Texas Tech University &mdash; from beamforming front ends and satellite antennas to portable radars for localization, vital signs, and 3D imaging.</p>
  </div>
</section>

<!-- PROJECTS SECTION -->
<section id="projects">
  <div class="section-header reveal">
    <span class="section-num">01</span>
    <h2 class="section-title">All Projects</h2>
    <div class="section-line"></div>
  </div>

  <div class="filter-bar reveal">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="radar">Radar</button>
    <button class="filter-btn" data-filter="mimo">MIMO</button>
    <button class="filter-btn" data-filter="beamforming">Beamforming</button>
    <button class="filter-btn" data-filter="vital">Vital Sign</button>
    <button class="filter-btn" data-filter="ic">IC Design</button>
    <button class="filter-btn" data-filter="antenna">Antenna Array</button>
    <button class="filter-btn" data-filter="rf">RF Circuits</button>
  </div>

  <div class="school-group">
  <div class="school-head reveal">
    <span class="school-name">Texas Tech University</span>
    <span class="school-meta">Ph.D., Electrical Engineering &middot; 2014&ndash;2018</span>
  </div>
  <div class="proj-grid">

    <!-- 1: Portable 24-GHz 3D MIMO Radar -->
    <a class="proj-card reveal" href="/2017/09/27/portable-24-ghz-3d-mimo-radar/" target="_blank" data-tags="radar mimo">
      <div class="proj-card-img-wrap">
        <img class="proj-card-img" src={portable24Ghz3dMimoRadar3dViewUrl} alt="Portable 24-GHz 3D MIMO Radar" loading="lazy">
        <span class="proj-card-year">2017</span>
      </div>
      <div class="proj-card-body">
        <div class="proj-card-tags">
          <span class="proj-tag tag-mimo">MIMO</span>
          <span class="proj-tag tag-radar">RADAR</span>
        </div>
        <h3>Portable 24-GHz 3D MIMO Radar</h3>
        <p>A K-band MIMO FMCW radar with a 90&deg; field of view and 3&deg; designed angular resolution in both azimuth and elevation. A non-uniformly spaced array of 16 Tx and 16 Rx antennas enables 3D localization.</p>
        <div class="proj-card-footer">
          <span class="proj-pub-count"><i class="fa-solid fa-file-lines"></i> 1 Journal Paper</span>
          <span class="proj-read-more">Read More <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>
    </a>

    <!-- 2: K-Band 2D RF Beamforming FMCW Radar -->
    <a class="proj-card reveal reveal-delay-1" href="/2017/01/28/k-band-2d-rf-beamforming-fmcw-radar/" target="_blank" data-tags="radar beamforming">
      <div class="proj-card-img-wrap">
        <img class="proj-card-img" src={kBand2dRfBeamformingFmcwRadarPhotoUrl} alt="K-Band 2D RF Beamforming FMCW Radar" loading="lazy">
        <span class="proj-card-year">2017</span>
      </div>
      <div class="proj-card-body">
        <div class="proj-card-tags">
          <span class="proj-tag tag-beamforming">Beamforming</span>
          <span class="proj-tag tag-radar">FMCW</span>
        </div>
        <h3>K-Band 2D RF Beamforming FMCW Radar</h3>
