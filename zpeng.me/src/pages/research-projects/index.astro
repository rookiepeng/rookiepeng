<script is:inline data-cfasync="false">
/* <![CDATA[ */
(function () {

  /* ---------- Reveal on scroll ---------- */
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(function (el) { observer.observe(el); });

  /* ---------- Filter buttons ---------- */
  var filterBtns = document.querySelectorAll('.filter-btn');
  var projCards  = document.querySelectorAll('.proj-card');

  filterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filterBtns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.dataset.filter;
      projCards.forEach(function (card) {
        var tags = card.dataset.tags || '';
        if (filter === 'all' || tags.indexOf(filter) !== -1) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
      document.querySelectorAll('.school-group').forEach(function (group) {
        group.classList.toggle('hidden', !group.querySelector('.proj-card:not(.hidden)'));
      });
    });
  });

  /* ---------- Hero radar canvas ---------- */
  (function () {
    var canvas = document.getElementById('hero-canvas');
    var hero   = document.getElementById('hero');
    if (!canvas || !hero) return;
    var ctx = canvas.getContext('2d');
    var reduce = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)').matches : false;
    var WHITE = '236,232,220', BLUE = '91,143,245';
    var W = 0, H = 0;

    var MAX_DOTS = 30, SPAWN_RATE = 14, dots = [];   // spawn rate in dots per second
    function spawnDot() {
      // keep dots in the right part of the hero, away from the title and text
      dots.push({
        x: W * (0.55 + Math.random() * 0.43), y: H * (0.08 + Math.random() * 0.8),
        r: 0.8 + Math.random() * 1.6,
        life: 0, maxLife: 1 + Math.random() * 1.3,
        color: Math.random() < 0.5 ? WHITE : BLUE
      });
    }

    function resize() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = hero.clientWidth;
      H = hero.clientHeight;
      canvas.width  = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      dots = [];
    }

    function drawChirp(t, amp, phaseOff, alpha, lw) {
      var y0 = H - 34;
      var grad = ctx.createLinearGradient(0, 0, W, 0);
      grad.addColorStop(0,   'rgba(' + WHITE + ',0)');
      grad.addColorStop(0.2, 'rgba(' + WHITE + ',' + alpha + ')');
      grad.addColorStop(0.8, 'rgba(' + WHITE + ',' + alpha + ')');
      grad.addColorStop(1,   'rgba(' + WHITE + ',0)');
      ctx.beginPath();
      for (var x = 0; x <= W; x += 2) {
        var xn = x / W;
        var y  = y0 + Math.sin(2 * Math.PI * (4 * xn + 9 * xn * xn) - t * 1.2 + phaseOff) * amp;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = grad;
      ctx.lineWidth = lw;
      ctx.stroke();
    }

    function draw(t) {
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < dots.length; i++) {
        var d = dots[i];
        var prog = d.life / d.maxLife;
        var a = prog < 0.3 ? (prog / 0.3) * 0.5 : (1 - prog) * 0.5;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + d.color + ',' + a + ')';
        ctx.fill();
      }
      drawChirp(t, 8, 0,         0.22, 1.1);
      drawChirp(t, 3.5, Math.PI/2, 0.10, 0.8);
    }

    function step(dt) {
      if (dots.length < MAX_DOTS) { if (Math.random() < SPAWN_RATE * dt) spawnDot(); }
      for (var i = dots.length - 1; i >= 0; i--) {
        dots[i].life += dt;
        if (dots[i].life >= dots[i].maxLife) dots.splice(i, 1);
      }
    }

    var t = 0, last = 0, rafId = 0, running = false, inView = true;
    function loop(ts) {
      var dt = last ? Math.min((ts - last) / 1000, 0.1) : 0;
      last = ts;
      t += dt;
      step(dt);
      draw(t);
      rafId = requestAnimationFrame(loop);
    }
    function start() { if (running || reduce) return; running = true; last = 0; rafId = requestAnimationFrame(loop); }
    function stop()  { running = false; cancelAnimationFrame(rafId); }
    function sync()  { if (!inView || document.hidden) { stop(); } else { start(); } }

    function redraw() {
      resize();
      if (reduce) {
        for (var i = 0; i < 12; i++) { spawnDot(); dots[i].life = dots[i].maxLife * 0.3; }
      }
      if (!running) draw(t);
    }
    redraw();

    if (window.ResizeObserver) { new ResizeObserver(redraw).observe(hero); }
    else { window.addEventListener('resize', redraw); }
    if (window.IntersectionObserver) {
      new IntersectionObserver(function (entries) { inView = entries[0].isIntersecting; sync(); }).observe(hero);
    }
    document.addEventListener('visibilitychange', sync);
    sync();
  })();

})();
/* ]]> */
</script>
