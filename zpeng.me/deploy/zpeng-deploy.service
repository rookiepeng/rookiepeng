[Unit]
Description=Build and publish zpeng.me from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zpeng-deploy
Environment=REPO_DIR=/srv/zpeng-static/repo SITE_DIR=/srv/zpeng-static/public
ExecStart=/usr/bin/bash /srv/zpeng-static/repo/zpeng.me/deploy/deploy.sh
Nice=10
