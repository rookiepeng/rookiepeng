# Serves the built site to cloudflared on localhost only. Cloudflare terminates TLS,
# so Caddy speaks plain HTTP and is never exposed to the network.
{
	auto_https off
	admin off
}

http://:8080 {
	bind 127.0.0.1
	root * /var/www/zpeng.me
	encode zstd gzip

	# Old WordPress feed and admin URLs
	redir /feed/ /feed.xml 301
	redir /comments/feed/ /feed.xml 301
	@wp path /wp-login.php /wp-admin /wp-admin/* /xmlrpc.php
	respond @wp 404

	# Fingerprinted build assets never change; everything else revalidates
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
